# Compiled source #
###################

# Exclude anywhere #
.DS_Store
.venv/
__pycache__/
.ipynb_checkpoints/
.vscode/
.spyproject/
*.log

# Exclude on top-level #
/build/
/dist/
/dynamite.egg-info/

# Orblib Fortran files #
orblib_fortran/*.mod
orblib_fortran/*.o
orblib_fortran/bin/
orblib_fortran/build/
orblib_fortran/orbitstart
orblib_fortran/orbitstart_bar
orblib_fortran/orblib_bar
orblib_fortran/orblib_new_mirror
orblib_fortran/triaxmass
orblib_fortran/triaxmass_bar
orblib_fortran/triaxmassbin
orblib_fortran/triaxmassbin_bar

