archive/dev_tests/NGC6278_output/*
archive/dev_tests/bartest_output
archive/dev_tests/test_all
archive/dev_tests/bayes_losvd/IC0719_input/
archive/dev_tests/bayes_losvd/IC0719_output/
archive/dev_tests/Data_prep/Dyn_input/ATLAS3D/*
archive/dev_tests/Data_prep/Dyn_input/CALIFA/*

